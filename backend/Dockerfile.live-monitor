# Imagem dedicada para o Monitor de Lives do YouTube e Scrapers do SACIBot
# Build: docker build -f backend/Dockerfile.live-monitor -t <usuario>/sacibot-live-monitor:latest ./backend
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SQLITE_PATH=/app/data/db.sqlite3

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

COPY . /app/
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh && mkdir -p /app/data

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python", "manage.py", "run_youtube_monitor"]
