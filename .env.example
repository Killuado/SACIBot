DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BOT_API_TOKEN=replace-with-a-long-random-service-token
DISCORD_BOT_TOKEN=
# IDs numéricos do Discord (separados por vírgula) autorizados a gerenciar lives (/youtube)
DISCORD_ADMIN_IDS=
BACKEND_API_URL=http://127.0.0.1:8000

# Para PostgreSQL
# DB_ENGINE=postgres
# POSTGRES_DB=sacibot
# POSTGRES_USER=sacibot
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432


# Scrapers / ingestão
PROMOTION_RETENTION_DAYS=3
# SCRAPERS_LOG_LEVEL=INFO

# Telegram (Telethon) - credenciais em https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Caminho do arquivo de sessão (sem .session). Nunca versione esse arquivo.
# TELEGRAM_SESSION=sacibot_telegram
# Opcional: bots só recebem mensagens de canais onde são administradores.
# Para canais públicos de terceiros, deixe vazio e use uma conta de usuário.
TELEGRAM_BOT_TOKEN=
# Canais separados por vírgula (@usuario, link t.me ou ID numérico)
TELEGRAM_CHANNELS=

# Monitor de Lives do YouTube
# YOUTUBE_CHECK_INTERVAL=120
# YOUTUBE_RECHECK_LIVE_SECONDS=300
# YOUTUBE_LINK_TTL_SECONDS=180
# YOUTUBE_INGEST_WORKERS=4
# YOUTUBE_MAX_SOURCES=50
# TELEGRAM_LINK_TTL_SECONDS=180
